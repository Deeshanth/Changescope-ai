# Backend Configuration
APP_ENV=development
DATABASE_URL=sqlite:///./changescope.db

# Optional comma-separated list of allowed parent directories for local Git repos.
# Example on Windows: ALLOWED_REPO_ROOTS=C:\Users\P R Deeshanth\projects
ALLOWED_REPO_ROOTS=

# Maximum file size (bytes) read during static AST scanning (default 2MB)
MAX_SOURCE_FILE_BYTES=2000000

# Optional Claude API Configuration (never exposed to frontend)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Frontend CORS origin
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
